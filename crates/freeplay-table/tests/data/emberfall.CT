      <AssemblerScript>[ENABLE]
aobscanmodule(giveExp,emberfall.exe,03 46 2C 89 46 2C)
alloc(newgiveExp,100,giveExp)
label(returngiveExp)
label(expMultVal)
registersymbol(expMultVal)
registersymbol(giveExp)
newgiveExp:
  push ebx
  mov ebx,[expMultVal]
  imul eax,ebx
  pop ebx
  add eax,[esi+2C]
  mov [esi+2C],eax
  jmp returngiveExp
expMultVal:
  dd (int)1
giveExp:
  jmp newgiveExp
  nop
returngiveExp:

[DISABLE]
giveExp:
  db 03 46 2C 89 46 2C
unregistersymbol(giveExp)
unregistersymbol(expMultVal)
dealloc(newgiveExp)
