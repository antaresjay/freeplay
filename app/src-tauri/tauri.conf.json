{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freeplay",
  "version": "0.1.0",
  "identifier": "dev.freeplay.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Freeplay",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#0a0b0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://art.localhost art://localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "antaresjay",
    "homepage": "https://github.com/antaresjay/freeplay",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Open source game trainer",
    "longDescription": "Find and change values in single player games. Free, open source, no account."
  }
}
